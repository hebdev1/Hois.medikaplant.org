# ─────────────────────────────────────────────────────────────────────────────
# Hoïs MedikaPlant — environment variables.
# Copy to .env.local for development, or set these in Hostinger's panel.
# NEVER commit real secrets. NEXT_PUBLIC_* values ship to the browser and must
# not hold anything sensitive; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable / anon key (safe to expose; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-ONLY. Full-access key that bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret for the Supabase "Send Email" auth hook → /api/auth/send-email.
SUPABASE_AUTH_HOOK_SECRET=your-auth-hook-secret

# ── Site (required) ──────────────────────────────────────────────────────────
# Canonical public URL. Used for absolute links in emails, redirects, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Stripe (payments) ────────────────────────────────────────────────────────
# Server-only. Test vs live is decided by which key is set — code is identical.
# Price IDs differ between modes, so subscription_plans.stripe_price_id_* must
# match the key's mode.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard → Developers → Webhooks, endpoint <site>/api/webhooks/stripe.
# Required — the webhook rejects unsigned calls.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Safe to expose — identifies the account. Used by the on-page card fields.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Server-only. Used for auth emails, member notifications, contact replies.
RESEND_API_KEY=re_xxx
# The "From" address (must be a verified sender/domain in Resend).
EMAIL_FROM="Hoïs <noreply@hoismedikaplant.com>"
# Optional Reply-To for contact-form replies (falls back to EMAIL_FROM).
CONTACT_REPLY_TO=plant@hoismedikaplant.com

# ── Web Push (notifications) ─────────────────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:plant@hoismedikaplant.com

# ── Cron / background jobs ───────────────────────────────────────────────────
# Bearer token guarding /api/cron/* and /api/webhooks/badge-unlocked. The push
# / scheduling stack is dark until this is set (endpoints 401 without it).
CRON_SECRET=your-long-random-cron-secret

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── HubSpot CRM (optional) ───────────────────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=pat-xxx

# ── Runtime (set automatically by the host; do not set locally) ──────────────
# PORT, HOSTNAME — provided by Hostinger/LiteSpeed (see server.js).
